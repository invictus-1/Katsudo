{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Katsudo",
  "version": "1.0.3",
  "identifier": "app.katsudo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Katsudō",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#15130f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src http://127.0.0.1:47811"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Local-first activity and input tracker",
    "longDescription": "Katsudō records your app timeline, keys, clicks and network use on this machine, with verified backups and imports from ManicTime and WhatPulse.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "headerImage": "windows/installer-header.bmp",
        "sidebarImage": "windows/installer-sidebar.bmp"
      }
    }
  }
}
